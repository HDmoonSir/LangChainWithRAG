# --- LLM Server Configuration ---
# vLLM internal port is 8000 (mapped to 8001~8004)

# 1. Router: Intent classification (0.5B ~ 1.5B)
ROUTER_LLM_URL=http://llm-langchain-router:8001/v1
ROUTER_MODEL_NAME=qwen-router
ROUTER_TEMPERATURE=0.0

# 2. Rewriter: Search query optimization (0.5B ~ 1.5B)
REWRITER_LLM_URL=http://llm-langchain-rewriter:8002/v1
REWRITER_MODEL_NAME=qwen-rewriter
REWRITER_TEMPERATURE=0.0

# 3. Sub: Daily Conversation / Small talk (1.5B ~ 3B)
SUB_LLM_URL=http://llm-langchain-sub:8003/v1
SUB_MODEL_NAME=qwen-sub
SUB_TEMPERATURE=0.7

# 4. Main: Final RAG answer generation (7B ~ 14B)
MAIN_LLM_URL=http://llm-langchain-generator:8004/v1
MAIN_MODEL_NAME=qwen-main
MAIN_TEMPERATURE=0.3

# --- Vector DB & Infrastructure ---
QDRANT_URL=http://llm-langchain-qdrant:6333
COLLECTION_NAME=kb_documents
LOCAL_MODEL_DEVICE=cuda:2
